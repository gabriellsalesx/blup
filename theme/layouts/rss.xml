{{- /* RSS without hidden notes; protected notes show only their title. */ -}}
{{- $set := partialCached "site/settings.html" . "site" -}}
{{- $pages := partial "visible.html" (cond .IsHome site.RegularPages .RegularPagesRecursive) -}}
{{- /* In Bento the site, tag and author feeds carry news (blog and
changelog), not docs or help pages. */ -}}
{{- if and (eq site.Params.model "bento") (or .IsHome (in (slice "taxonomy" "term") .Kind)) -}}
  {{- $news := first 0 $pages -}}
  {{- range $pages }}{{ if in (slice "blog" "changelog") (lower (string .FirstSection.Params.blup)) }}{{ $news = $news | append . }}{{ end }}{{ end -}}
  {{- $pages = $news -}}
{{- end -}}
{{- $pages = $pages.ByDate.Reverse | first 20 -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ $set.name }}{{ else }}{{ partial "title.html" . }} · {{ $set.name }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $set.description | default $set.name }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{- with $pages }}{{ with (index . 0).Date }}{{ if not .IsZero }}<lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}{{ end }}{{ end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ partial "title.html" . }}</title>
      <link>{{ .Permalink }}</link>
      {{- if not .Date.IsZero }}
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ partial "description.html" . }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
