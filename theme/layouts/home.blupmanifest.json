{{- /* Web app manifest: the site can be installed as an app (phone home
screen, desktop) and opens offline. The CLI writes the icons it lists and
the service worker after the build (internal/pwa). */ -}}
{{- $set := partialCached "site/settings.html" . "site" -}}
{{- $home := site.Home.RelPermalink -}}
{{- $icons := slice
  (dict "src" ("icons/icon-192.png" | relURL) "sizes" "192x192" "type" "image/png" "purpose" "any")
  (dict "src" ("icons/icon-512.png" | relURL) "sizes" "512x512" "type" "image/png" "purpose" "any")
  (dict "src" ("icons/maskable-512.png" | relURL) "sizes" "512x512" "type" "image/png" "purpose" "maskable") -}}
{{- dict
  "name" $set.name
  "short_name" $set.name
  "description" ($set.description | default "")
  "lang" site.Language.Lang
  "start_url" $home
  "scope" $home
  "id" $home
  "display" "standalone"
  "background_color" "#fafafa"
  "theme_color" "#fafafa"
  "icons" $icons
  | jsonify -}}
