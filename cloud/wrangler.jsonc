{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blup-cloud",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-28",
	// Better Auth usa AsyncLocalStorage.
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// A limpeza diária das versões antigas e dos blocos sem uso (04:00 UTC).
	"triggers": { "crons": ["0 4 * * *", "*/5 * * * *"] },
	"upload_source_maps": true,
	// O painel (SvelteKit estático) é servido como assets; só a API passa
	// pelo Worker.
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/staff", "/staff/*"]
	},
	// Os IDs reais ficam fora do repositório público: troque na hora de
	// publicar (npx wrangler d1 create blup-cloud).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blup-cloud",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// NOTES: as notas sincronizadas (cifradas). SITES: os arquivos dos sites
	// publicados pela nuvem (planos pagos), que o Worker de
	// wrangler.sites.jsonc serve em <nome>.SITES_DOMAIN.
	"r2_buckets": [
		{ "binding": "NOTES", "bucket_name": "blup-cloud-notes" },
		{ "binding": "SITES", "bucket_name": "blup-cloud-sites" }
	],
	// A sala ao vivo de cada conta (sincronização em tempo real dos planos
	// pagos), com hibernação de WebSocket.
	"durable_objects": { "bindings": [{ "name": "SYNC_LIVE", "class_name": "SyncLive" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncLive"] }],
	"send_email": [{ "name": "EMAIL" }],
	"ratelimits": [
		// Pedidos de código por e-mail: por IP, por minuto.
		{ "name": "OTP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "ABUSE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "BULK_LIMIT", "namespace_id": "1003", "simple": { "limit": 500, "period": 10 } }
	],
	"vars": {
		// Sem domínio ainda: em produção troque pelo endereço do Blup Cloud.
		"APP_URL": "http://localhost:8787",
		"PASSKEY_RP_ID": "localhost",
		"MAIL_FROM": "Blup <login@example.com>",
		// Chave de site de TESTE do Turnstile (pública, sempre aprova).
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		// "log" mostra o código no terminal em vez de mandar e-mail.
		"EMAIL_MODE": "log",
		// Vazio no computador: a staff fica em localhost:8787/staff.
		"STAFF_HOST": "",
		// Vazio: o OpenRouter de verdade (os testes apontam para um falso).
		"OPENROUTER_URL": "",
		// O endereço dos sites publicados (servidos pelo Worker de
		// wrangler.sites.jsonc): nome.localhost no computador.
		"SITES_DOMAIN": "localhost",
		"CF_ZONE_ID": "",
		"SITES_CNAME_TARGET": ""
	},
	// Produção: npx wrangler deploy --env production. Um Worker com dois
	// domínios: cloud.getblup.io (painel do usuário) e staff.getblup.io
	// (staff, com o Cloudflare Access na frente). Bindings e vars não são
	// herdados do topo, por isso se repetem aqui. Os IDs reais (D1) e os
	// segredos entram na hora do deploy, nunca no repositório.
	"env": {
		"production": {
			"workers_dev": false,
			"triggers": { "crons": ["0 4 * * *", "*/5 * * * *"] },
			"preview_urls": false,
			"routes": [
				{ "pattern": "cloud.getblup.io", "custom_domain": true },
				{ "pattern": "staff.getblup.io", "custom_domain": true }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "blup-cloud",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{ "binding": "NOTES", "bucket_name": "blup-cloud-notes" },
				{ "binding": "SITES", "bucket_name": "blup-cloud-sites" }
			],
			"durable_objects": { "bindings": [{ "name": "SYNC_LIVE", "class_name": "SyncLive" }] },
			// Só manda a partir do no-reply (o domínio getblup.io precisa estar
			// em Email Service > Email Sending na Cloudflare).
			"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@getblup.io"] }],
			"ratelimits": [
				{ "name": "OTP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		{ "name": "ABUSE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "BULK_LIMIT", "namespace_id": "1003", "simple": { "limit": 500, "period": 10 } }
			],
			"vars": {
				"APP_URL": "https://cloud.getblup.io",
				// A passkey vale em getblup.io e nos subdomínios; o login confere a
				// origem (cloud.getblup.io), então outro subdomínio não a usa.
				"PASSKEY_RP_ID": "getblup.io",
				"MAIL_FROM": "Blup <no-reply@getblup.io>",
				// Troque pela chave de site real do Turnstile (é pública).
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
				"EMAIL_MODE": "send",
				"STAFF_HOST": "staff.getblup.io",
				"OPENROUTER_URL": "",
				"SITES_DOMAIN": "getblup.site",
				"CF_ZONE_ID": "",
				"SITES_CNAME_TARGET": ""
			}
		}
	}
}
