# Copie para .dev.vars (que fica fora do git) e troque os valores.
# Em produção, use: npx wrangler secret put NOME
BETTER_AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Chave secreta de TESTE do Turnstile (pública, sempre aprova).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Stripe em modo de TESTE (dashboard.stripe.com/test/apikeys). Nunca no git.
STRIPE_SECRET_KEY=sk_test_coloque_a_sua
# Do `stripe listen` (local) ou do webhook criado no dashboard (produção).
STRIPE_WEBHOOK_SECRET=whsec_coloque_o_seu
# Área da staff. Em produção o Cloudflare Access fica na frente de /staff e
# /api/staff; o Worker confere o token dele com estes dois valores.
ACCESS_TEAM_DOMAIN=https://seu-time.cloudflareaccess.com
ACCESS_AUD=coloque-o-aud-da-aplicacao-do-access
# O primeiro admin (não precisa estar na tabela da staff).
STAFF_OWNER_EMAIL=voce@example.com
# SÓ no computador (localhost): entra na staff sem o Access, como este e-mail.
STAFF_DEV_EMAIL=voce@example.com
