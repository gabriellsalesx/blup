# Copie para .dev.vars (que fica fora do git) e troque os valores.
# Em produção, use: npx wrangler secret put NOME
BETTER_AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria
# Chave secreta de TESTE do Turnstile (pública, sempre aprova).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Stripe, do SANDBOX da conta Blup. Nunca no git. O Stripe recomenda uma
# chave restrita (rk_) só com as permissões do README, em vez da secreta (sk_).
STRIPE_SECRET_KEY=rk_test_coloque_a_sua
# Do `stripe listen` (local) ou do webhook criado no dashboard (produção).
STRIPE_WEBHOOK_SECRET=whsec_coloque_o_seu
# Área da staff. Em produção o Cloudflare Access fica na frente de /staff e
# /api/staff; o Worker confere o token dele com estes dois valores.
ACCESS_TEAM_DOMAIN=https://seu-time.cloudflareaccess.com
ACCESS_AUD=coloque-o-aud-da-aplicacao-do-access
# O primeiro admin (não precisa estar na tabela da staff).
STAFF_OWNER_EMAIL=voce@example.com
# SÓ no computador (localhost): entra na staff sem o Access, como este e-mail.
STAFF_DEV_EMAIL=voce@example.com
# Narração pelo Blup Cloud (planos pagos): a chave do OpenRouter do Blup.
OPENROUTER_API_KEY=sk-or-v1-coloque_a_sua
# Blup Deals: o token do bot do Deals (do BotFather) e o segredo que o
# Telegram manda no webhook (setWebhook secret_token). Vazios: sem Telegram.
DEALS_TELEGRAM_TOKEN=
DEALS_TELEGRAM_WEBHOOK_SECRET=
# Blup Deals: a conta do Blup na Rakuten Advertising (OAuth 2.0 do portal de
# desenvolvedores e o SID do site), só para ler o catálogo da Nuuvem. Vazios:
# sem a caçada da Nuuvem.
DEALS_RAKUTEN_CLIENT_ID=
DEALS_RAKUTEN_CLIENT_SECRET=
DEALS_RAKUTEN_SID=
# Google Play: a conta de revisão entra com um código fixo (6 dígitos) em vez
# do código por e-mail. Só em produção, como secret; vazios: sem conta de revisão.
REVIEW_EMAIL=
REVIEW_CODE=
