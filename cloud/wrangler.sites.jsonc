{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Os sites publicados pelo Blup Cloud (planos pagos), em <nome>.getblup.site.
	// Um Worker à parte do painel: sem assets nem login, só lê o banco (D1) e
	// os arquivos (R2) que o painel grava. Publicar:
	// npx wrangler deploy -c wrangler.sites.jsonc --env production
	"name": "blup-sites",
	"main": "worker/sites-entry.ts",
	"compatibility_date": "2026-10-28",
	"observability": { "enabled": true },
	"cache": { "enabled": false },
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"CachedSite": { "type": "worker", "cache": { "enabled": true } }
	},
	// O mesmo banco do painel (troque o ID na hora de publicar, como lá).
	"d1_databases": [
		{ "binding": "DB", "database_name": "blup-cloud", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
	],
	"r2_buckets": [{ "binding": "SITES", "bucket_name": "blup-cloud-sites" },{ "binding": "PULSE_ASSETS", "bucket_name": "blup-pulse-assets" },{ "binding": "DEALS_ASSETS", "bucket_name": "blup-deals-assets" }],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// No computador: nome.localhost:<porta>.
	"ratelimits": [{"name":"PULSE_PUBLIC_LIMIT","namespace_id":"1005","simple":{"limit":300,"period":60}},{"name":"DEALS_PUBLIC_LIMIT","namespace_id":"1006","simple":{"limit":300,"period":60}}],
	"vars": { "SITES_DOMAIN": "localhost", "PULSE_PUBLIC_HOST":"pulse.localhost" },
	"env": {
		"production": {
			"workers_dev": false,
			"preview_urls": false,
			// Um registro DNS curinga *.getblup.site (AAAA 100::, com proxy) e
			// a rota da zona também recebe os Custom Hostnames do Cloudflare for SaaS.
			"routes": [{ "pattern": "*/*", "zone_name": "getblup.site" }],
			"d1_databases": [
				{ "binding": "DB", "database_name": "blup-cloud", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
			],
			"r2_buckets": [{ "binding": "SITES", "bucket_name": "blup-cloud-sites" },{ "binding": "PULSE_ASSETS", "bucket_name": "blup-pulse-assets" },{ "binding": "DEALS_ASSETS", "bucket_name": "blup-deals-assets" }],
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"ratelimits": [{"name":"PULSE_PUBLIC_LIMIT","namespace_id":"1005","simple":{"limit":300,"period":60}},{"name":"DEALS_PUBLIC_LIMIT","namespace_id":"1006","simple":{"limit":300,"period":60}}],
			"durable_objects":{"bindings":[{"name":"PULSE_PROJECT","class_name":"PulseProject","script_name":"blup-cloud-production"}]},
			"vars": { "SITES_DOMAIN": "getblup.site", "PULSE_PUBLIC_HOST":"pulse.getblup.site" }
		}
	}
}
