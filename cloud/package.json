{
  "name": "blup-cloud",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "node worker/export-rpc.mjs && vite build",
    "check": "node worker/export-rpc.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy",
    "db:auth-schema": "cd worker && npx auth@latest generate --adapter drizzle --dialect sqlite --config auth.cli.ts --output db/auth-schema.ts --yes",
    "stripe:setup": "node scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@better-auth/stripe": "^1.7.14",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "stripe": "^23.1.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
